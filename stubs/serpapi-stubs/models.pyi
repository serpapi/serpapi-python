from collections import UserDict
from typing import Any, AsyncGenerator, Dict, Generic, Iterator, Mapping, Optional, TypeVar, Union

from typing_extensions import Protocol, Self

from .http import AsyncHTTPClient, HTTPClient

_ClientT = TypeVar("_ClientT", HTTPClient, AsyncHTTPClient)

# Both requests.Response and httpx2.Response can be parsed, regardless of the client.
class _Response(Protocol):
    @property
    def headers(self) -> Mapping[str, str]: ...
    @property
    def text(self) -> str: ...
    @property
    def content(self) -> bytes: ...
    def json(self) -> Any: ...

class _BaseSerpResults(UserDict[str, Any], Generic[_ClientT]):
    client: Optional[_ClientT]
    def __init__(self, data: Mapping[str, Any], *, client: Optional[_ClientT]) -> None: ...
    def __getstate__(self) -> Dict[str, Any]: ...
    def __setstate__(self, state: Dict[str, Any]) -> None: ...
    def as_dict(self) -> Dict[str, Any]: ...
    @property
    def next_page_url(self) -> Optional[str]: ...
    @classmethod
    def from_http_response(
        cls, r: _Response, *, client: Optional[_ClientT] = None
    ) -> Union[Self, str]: ...

class SerpResults(_BaseSerpResults[HTTPClient]):
    def next_page(self) -> Optional[SerpResults]: ...
    def yield_pages(self, max_pages: int = 1000) -> Iterator[SerpResults]: ...

class AsyncSerpResults(_BaseSerpResults[AsyncHTTPClient]):
    async def next_page(self) -> Optional[AsyncSerpResults]: ...
    def yield_pages(self, max_pages: int = 1000) -> AsyncGenerator[AsyncSerpResults, None]: ...
