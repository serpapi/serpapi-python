from collections import UserDict
from typing import Any, Dict, Iterator, Mapping, Optional, Union

import requests

from .http import HTTPClient

class SerpResults(UserDict[str, Any]):
    client: Optional[HTTPClient]
    def __init__(self, data: Mapping[str, Any], *, client: Optional[HTTPClient]) -> None: ...
    def __getstate__(self) -> Dict[str, Any]: ...
    def __setstate__(self, state: Dict[str, Any]) -> None: ...
    def as_dict(self) -> Dict[str, Any]: ...
    @property
    def next_page_url(self) -> Optional[str]: ...
    def next_page(self) -> Optional[SerpResults]: ...
    def yield_pages(self, max_pages: int = 1000) -> Iterator[SerpResults]: ...
    @classmethod
    def from_http_response(
        cls, r: requests.Response, *, client: Optional[HTTPClient] = None
    ) -> Union[SerpResults, str]: ...
